# Biến của platform/compose. Dùng: cp .env.example .env (file .env không vào Git).
# Mọi giá trị ở đây chỉ dùng trên Mac; lab lấy secret từ SealedSecret trong gitops.

# Bản checkout repo gitops, tính từ thư mục compose/. Hai init đọc từ đây: realm Keycloak và CR KafkaTopic.
GITOPS_DIR=../../gitops

# Superuser PostgreSQL (psql -h localhost -p 15432 -U postgres). Service không dùng.
POSTGRES_PASSWORD=postgres_local

# Admin bootstrap của Keycloak (realm master, http://localhost:18080/admin), cũng là tài khoản keycloak-config-cli dùng.
KC_BOOTSTRAP_ADMIN_PASSWORD=admin_local

# Secret của client smoke-test trong realm commerce-hub, thay vào $(env:SMOKE_TEST_CLIENT_SECRET) của file realm.
# Xin token: README.md mục "Thử hello".
SMOKE_TEST_CLIENT_SECRET=smoke-test-local-secret
